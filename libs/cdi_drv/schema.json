{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "CdiDrvConfig",
    "description": "Configuration for generating CDI device specifications and Linyaps device defaults.",
    "type": "object",
    "additionalProperties": false,
    "required": ["version", "generator"],
    "properties": {
        "version": {
            "type": "string",
            "const": "1"
        },
        "generator": {
            "type": "string",
            "enum": ["linglong", "command"]
        },
        "autoEnable": {
            "description": "Whether to enable the default device automatically.",
            "type": "boolean",
            "default": true
        },
        "kind": {
            "description": "CDI kind for the linglong generator.",
            "type": "string"
        },
        "defaultDevice": {
            "description": "The final CDI device name to enable. Without device profiles, names the single device generated by linglong; defaults to <file stem>-linglong. Otherwise, if omitted, selects the first generated device.",
            "$ref": "#/definitions/DeviceName"
        },
        "profile": {
            "description": "Common configuration for each device profile. List fields are appended and a device's DRM selector overrides the global selector. When deviceProfile is absent or empty, generates one device named by defaultDevice or <file stem>-linglong if omitted.",
            "allOf": [{ "$ref": "#/definitions/Profile" }]
        },
        "deviceProfile": {
            "type": "array",
            "items": { "$ref": "#/definitions/DeviceProfile" }
        },
        "argv": {
            "description": "Executable and arguments of the command that writes one CDI specification to stdout. The executable may be a command name or an absolute path.",
            "type": "array",
            "items": { "type": "string" }
        },
        "timeout": {
            "description": "Maximum command generator execution time in seconds. The generator process group is terminated when the timeout expires.",
            "type": "integer",
            "default": 30
        },
        "watchPathChanged": {
            "description": "Absolute paths whose changes trigger regeneration.",
            "type": "array",
            "uniqueItems": true,
            "items": {
                "type": "string",
                "pattern": "^/"
            }
        }
    },
    "if": {
        "properties": { "generator": { "const": "linglong" } }
    },
    "then": {
        "required": ["kind"],
        "properties": {
            "kind": { "pattern": "^[^/=\\s]+/[^/=\\s]+$" }
        },
        "anyOf": [
            { "required": ["profile"] },
            {
                "required": ["deviceProfile"],
                "properties": {
                    "deviceProfile": { "minItems": 1 }
                }
            }
        ]
    },
    "else": {
        "required": ["argv"],
        "properties": {
            "argv": {
                "minItems": 1,
                "items": [{ "type": "string", "minLength": 1 }]
            }
        }
    },
    "definitions": {
        "DeviceName": {
            "type": "string",
            "pattern": "^[A-Za-z0-9]([A-Za-z0-9_.:-]*[A-Za-z0-9])?$"
        },
        "DeviceProfile": {
            "type": "object",
            "additionalProperties": false,
            "required": ["device", "profile"],
            "properties": {
                "device": { "$ref": "#/definitions/DeviceName" },
                "profile": { "$ref": "#/definitions/Profile" }
            }
        },
        "Profile": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "drm": {
                    "description": "A DRM selector object. A device-level selector replaces the entire global selector. If omitted, inherits the global selector.",
                    "allOf": [{ "$ref": "#/definitions/DrmSelector" }]
                },
                "deviceNodes": {
                    "type": "array",
                    "items": { "$ref": "#/definitions/DeviceNode" }
                },
                "mountFiles": {
                    "type": "array",
                    "items": {
                        "oneOf": [
                            {
                                "description": "A file mounted read-only at the same path in the container.",
                                "type": "string",
                                "minLength": 1
                            },
                            { "$ref": "#/definitions/MountFile" }
                        ]
                    }
                },
                "env": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "pattern": "^[^=]+="
                    }
                }
            }
        },
        "DrmSelector": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "kernelDriver": {
                    "description": "Kernel driver name to match. If omitted, do not restrict the kernel driver.",
                    "type": "string",
                    "minLength": 1
                },
                "pciIds": {
                    "description": "PCI vendor and device IDs. An asterisk matches any device ID for that vendor. If omitted or empty, do not restrict PCI IDs.",
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "pattern": "^[0-9A-Fa-f]{4}:([0-9A-Fa-f]{4}|\\*)$"
                    }
                },
                "nodes": {
                    "description": "DRM node types to include. If omitted, include both types when present. If empty, skip DRM node selection.",
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "enum": ["render", "primary"]
                    }
                }
            }
        },
        "DeviceNode": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path"],
            "properties": {
                "path": {
                    "description": "Path inside the container.",
                    "type": "string",
                    "pattern": "^/"
                },
                "hostPath": {
                    "description": "Host device path. If omitted, use path.",
                    "type": "string",
                    "pattern": "^/"
                },
                "required": { "type": "boolean" }
            }
        },
        "MountFile": {
            "type": "object",
            "additionalProperties": false,
            "required": ["hostPath"],
            "properties": {
                "hostPath": { "type": "string", "minLength": 1 },
                "path": {
                    "description": "Path inside the container. If omitted, use the resolved hostPath.",
                    "type": "string",
                    "pattern": "^/"
                },
                "required": { "type": "boolean" }
            }
        }
    }
}
