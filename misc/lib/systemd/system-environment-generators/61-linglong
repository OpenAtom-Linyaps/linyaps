# shellcheck shell=sh

# Environment generator for both system and user systemd managers.
# Update PATH and XDG_DATA_DIRS, then print them for systemd to import.
# Login sessions also need the profile.d/Xsession.d script because their
# startup scripts may reset PATH and import it back into the user manager.

source_script="@CMAKE_INSTALL_PREFIX@/lib/linglong/generate-path.sh"
[ -r "${source_script}" ] && . "${source_script}"

source_script="@CMAKE_INSTALL_PREFIX@/lib/linglong/generate-xdg-data-dirs.sh"

# Source the script and export XDG_DATA_DIRS if successful
[ -r "${source_script}" ] && . "${source_script}"

# !!!systemd requires environment variables to be printed to standard output!!!
# https://www.freedesktop.org/software/systemd/man/latest/systemd.environment-generator.html
# The tests are spelled out rather than chained with && so the script always
# exits 0. systemd discards everything a generator printed when it exits
# non-zero, so a run with an empty XDG_DATA_DIRS used to throw away the PATH
# line as well.
if [ -n "${PATH}" ]; then
    echo "PATH=${PATH}"
fi
if [ -n "${XDG_DATA_DIRS}" ]; then
    echo "XDG_DATA_DIRS=${XDG_DATA_DIRS}"
fi

exit 0
