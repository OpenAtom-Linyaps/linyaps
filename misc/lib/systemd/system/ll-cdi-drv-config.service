[Unit]
Description=Request a full CDI driver configuration refresh
StartLimitIntervalSec=0
Wants=ll-cdi-drv-refresh.path
After=systemd-tmpfiles-setup.service ll-cdi-drv-refresh.path

[Service]
Type=oneshot
ExecStart=@CMAKE_INSTALL_FULL_LIBEXECDIR@/linglong/ll-cdi-drv refresh --request-all

[Install]
WantedBy=multi-user.target
