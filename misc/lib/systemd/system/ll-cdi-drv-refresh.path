[Unit]
Description=Watch pending CDI driver refresh requests

[Path]
PathExists=/run/linglong-cdi-drv/pending/refresh-all
DirectoryNotEmpty=/run/linglong-cdi-drv/pending/refresh-single
Unit=ll-cdi-drv-refresh.service

[Install]
WantedBy=multi-user.target
