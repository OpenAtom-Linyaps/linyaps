[Unit]
Description=Generate and publish pending CDI driver configurations
After=systemd-tmpfiles-setup.service

[Service]
Type=oneshot
# Claim requests before synchronizing watches so concurrent requests remain queued.
# Keep consuming requests until the queue has been idle for five seconds.
ExecStart=@CMAKE_INSTALL_FULL_LIBEXECDIR@/linglong/ll-cdi-drv refresh-pending
