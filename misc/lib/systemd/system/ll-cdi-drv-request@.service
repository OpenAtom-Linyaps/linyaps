[Unit]
Description=Request a CDI driver configuration refresh for %I
StartLimitIntervalSec=0
Wants=ll-cdi-drv-refresh.path
After=ll-cdi-drv-refresh.path

[Service]
Type=oneshot
# Configuration names contain only ASCII letters, digits, '.', '_', and '-'.
ExecStart=@CMAKE_INSTALL_FULL_LIBEXECDIR@/linglong/ll-cdi-drv refresh "--request=%I"
