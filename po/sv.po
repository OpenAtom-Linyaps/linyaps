#: ../apps/ll-cli/src/main.cpp:81
msgid "Run an application"
msgstr "Kör en applikation"

#. add sub command run options
#: ../apps/ll-cli/src/main.cpp:84
msgid "Specify the application ID"
msgstr "Ange program-ID"

#: ../apps/ll-cli/src/main.cpp:87
msgid ""
"Usage: ll-cli run [OPTIONS] APP [COMMAND...]\n"
"\n"
"Example:\n"
"# run application by appid\n"
"ll-cli run org.deepin.demo\n"
"# execute commands in the container rather than running the application\n"
"ll-cli run org.deepin.demo bash\n"
"ll-cli run org.deepin.demo -- bash\n"
"ll-cli run org.deepin.demo -- bash -x /path/to/bash/script"
msgstr ""
"Användning: ll-cli run [FLAGGOR] APP [KOMMANDO...]\n"
"\n"
"Exempel:\n"
"# kör applikation efter appid\n"
"ll-cli run org.deepin.demo\n"
"# kör kommandon i behållaren istället för att köra applikationen\n"
"ll-cli run org.deepin.demo bash\n"
"ll-cli run org.deepin.demo -- bash\n"
"ll-cli run org.deepin.demo -- bash -x /sökväg/till/bash/script"

